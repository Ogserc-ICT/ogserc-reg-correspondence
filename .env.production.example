# Production settings for docker-compose.prod.yml (docs/OPERATIONS.md).
# Copy to .env.production, fill in every value, and keep it off git.

# Database password for the bundled PostgreSQL (long and random).
POSTGRES_PASSWORD=""

# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# The public HTTPS address staff use, e.g. https://registry.ogserc.gov.ng
BETTER_AUTH_URL=""

# Shared secret the scheduler sends to /api/jobs/<job> (random, 32+ characters).
CRON_SECRET=""

# Backups: keep this many days on the server; optional command to copy each
# new backup off the server ({} is replaced by the file name).
BACKUP_KEEP_DAYS="30"
BACKUP_UPLOAD_CMD=""

# Never set in production (the app refuses to start): APP_NOW, APP_NOW_FILE,
# DEV_SEED_PASSWORD.

# Acknowledgement email: leave EMAIL_TRANSPORT empty until a provider is
# chosen (Q-V2-1). "dev" is refused in production.
EMAIL_TRANSPORT=""
EMAIL_FROM=""
