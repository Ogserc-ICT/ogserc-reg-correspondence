// OGSERC Registry: data model (SPEC §1, STACK rules 8–10).
//
// Conventions
// - Business dates are @db.Date; the domain handles them as "YYYY-MM-DD".
//   Only InwardItem.receivedAt and FileMovement.outAt are timestamps.
// - Inward/outward items are never deleted (voided instead); numbers never
//   change. Both are enforced by triggers in the init migration.
// - snap* columns hold the type and settings rules as they were when the item
//   was saved, so later edits to types or settings never rewrite history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REGISTRY_OFFICER
  HEAD_OF_REGISTRY
  UNIT_OFFICER
  SECRETARY
  ADMIN
  /// SPEC-v2 C12: logs front desk intakes only.
  FRONT_DESK_OFFICER
}

enum Series {
  ACK
  OUT
  /// Front desk intakes (SPEC-v2 C3.1).
  FD
}

enum ListKind {
  RECEIPT_MODE
  LGA
  ACK_VIA
  PARTY_CATEGORY
  ACTION_REQUIRED
  PRIORITY
  FILE_CLASS
  FILE_SECURITY
  FILE_STATUS
}

/// SPEC-v2 C6.3. Default OFF until a real email provider is configured (Q-V2-1).
enum AckEmailMode {
  OFF
  REVIEW
  SEND
}

/// SPEC-v2 C6.5.
enum EmailKind {
  ACK
  ROUTING
  RESEND
}

/// SPEC-v2 C6.5, plus DISCARDED and SUPERSEDED (agreed on review).
enum EmailStatus {
  QUEUED
  PENDING_REVIEW
  SENT
  FAILED
  DISCARDED
  SUPERSEDED
}

enum HolidayStatus {
  FIXED
  PROVISIONAL
  ESTIMATED
}

/// Which footer the acknowledgement slip prints (TEMPLATES §1, Q4).
enum SlipFooter {
  REGISTRATION
  PARA103
  GENERAL
}

enum InwardStatus {
  VOID
  CLOSED
  OVERDUE
  AWAITING_ROUTING
  AWAITING_FORWARDING
  NOTED_FILED
  OPEN
}

enum OutwardStatus {
  VOID
  NOT_YET_DISPATCHED
  RESPONSE_RECEIVED
  RESPONSE_OVERDUE
  AWAITING_RESPONSE
  DELIVERED
  DISPATCHED
}

// ---------------------------------------------------------------- users ---

/// Staff. Admin-created only; Better Auth reads and writes the core fields.
model User {
  id                 String    @id @default(uuid(7)) @db.Uuid
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String?
  role               Role
  /// Unit officers only: the unit whose items they may read.
  unitId             String?   @db.Uuid
  unit               Unit?     @relation(fields: [unitId], references: [id])
  isSignatory        Boolean   @default(false)
  /// SPEC-v2 C5.1/C12: grants registry.route on top of the role, nothing else.
  canRoute           Boolean   @default(false)
  designation        String?
  active             Boolean   @default(true)
  failedLogins       Int       @default(0)
  lockedUntil        DateTime? @db.Timestamptz
  /// Set when an admin issues a temporary password; cleared when the user changes it.
  mustChangePassword Boolean   @default(false)
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @updatedAt @db.Timestamptz

  inwardReceived    InwardItem[]       @relation("InwardReceivedBy")
  inwardCreated     InwardItem[]       @relation("InwardCreatedBy")
  inwardVoided      InwardItem[]       @relation("InwardVoidedBy")
  outwardDispatched OutwardItem[]      @relation("OutwardDispatchedBy")
  outwardCreated    OutwardItem[]      @relation("OutwardCreatedBy")
  outwardVoided     OutwardItem[]      @relation("OutwardVoidedBy")
  filesCreated      RegistryFile[]
  movementsReleased FileMovement[]     @relation("MovementReleasedBy")
  movementsIssuedTo FileMovement[]     @relation("MovementIssuedTo")
  movementsReceived FileMovement[]     @relation("MovementReceivedBackBy")
  inwardRouted      InwardItem[]       @relation("InwardRoutedBy")
  routingEvents     RoutingEvent[]
  intakesReceived   FrontDeskIntake[]
  emailsCreated     EmailLog[]         @relation("EmailCreatedBy")
  emailsReviewed    EmailLog[]         @relation("EmailReviewedBy")
  auditEntries      AuditLog[]
  settingsUpdates   RegistrySettings[]
  sessions          Session[]
  accounts          Account[]
  jobRuns           JobRun[]
}

/// Better Auth: one row per signed-in browser.
model Session {
  id        String   @id @default(uuid(7)) @db.Uuid
  expiresAt DateTime @db.Timestamptz
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz
  updatedAt DateTime @updatedAt @db.Timestamptz
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Better Auth: the "credential" account holds the argon2 password hash.
model Account {
  id                    String    @id @default(uuid(7)) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz
  refreshTokenExpiresAt DateTime? @db.Timestamptz
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz

  @@unique([providerId, accountId])
  @@index([userId])
}

/// Better Auth: one-time tokens (unused while sign-up and email flows are off).
model Verification {
  id         String   @id @default(uuid(7)) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz
  createdAt  DateTime @default(now()) @db.Timestamptz
  updatedAt  DateTime @updatedAt @db.Timestamptz

  @@index([identifier])
}

// ------------------------------------------------------- reference data ---

/// SPEC-v2 C1: the five divisions; a unit's division is derived for items.
model Division {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  /// 0..n addresses; lower-cased, deduplicated.
  emails    String[] @default([])
  sortOrder Int      @default(0)
  active    Boolean  @default(true)

  units Unit[]
}

model Unit {
  id         String    @id @default(uuid(7)) @db.Uuid
  name       String    @unique
  /// Null only for units added before v2 or by an admin without one.
  divisionId String?   @db.Uuid
  division   Division? @relation(fields: [divisionId], references: [id], onDelete: Restrict)
  unitGroup  String?
  /// 0..n addresses; lower-cased, deduplicated.
  emails     String[]  @default([])
  sortOrder  Int       @default(0)
  active     Boolean   @default(true)

  users             User[]
  incomingTypes     IncomingType[]
  inwardRouted      InwardItem[]   @relation("InwardRoutedUnit")
  inwardOverride    InwardItem[]   @relation("InwardUnitOverride")
  inwardSnapDefault InwardItem[]   @relation("InwardSnapDefaultUnit")
  outwardOriginated OutwardItem[]
  filesOwned        RegistryFile[]
  movements         FileMovement[]
}

/// One value of a simple list. Values the rules depend on carry a systemKey;
/// admins can rename them but not delete them.
model ListItem {
  id                     String   @id @default(uuid(7)) @db.Uuid
  list                   ListKind
  label                  String
  sortOrder              Int      @default(0)
  active                 Boolean  @default(true)
  systemKey              String?
  /// RECEIPT_MODE only: receipt at or after the closing time is deemed next working day (§2.1, Q3).
  afterHoursCutoff       Boolean  @default(false)
  /// RECEIPT_MODE only: dispatch by this mode never needs proof of delivery (§5.4).
  noDeliveryConfirmation Boolean  @default(false)
  /// FILE_CLASS only: code for generated file references, e.g. RL (SPEC-v2 C8).
  code                   String?

  inwardMode           InwardItem[]      @relation("InwardMode")
  inwardSenderCategory InwardItem[]      @relation("InwardSenderCategory")
  inwardLga            InwardItem[]      @relation("InwardLga")
  inwardAckVia         InwardItem[]      @relation("InwardAckVia")
  inwardAction         InwardItem[]      @relation("InwardAction")
  intakeMode           FrontDeskIntake[]
  inwardPriority       InwardItem[]      @relation("InwardPriority")
  outwardRecipientCat  OutwardItem[]     @relation("OutwardRecipientCategory")
  outwardDispatchMode  OutwardItem[]     @relation("OutwardDispatchMode")
  filesClass           RegistryFile[]    @relation("FileClass")
  filesSecurity        RegistryFile[]    @relation("FileSecurity")
  filesStatus          RegistryFile[]    @relation("FileStatus")

  @@unique([list, label])
  @@unique([list, systemKey])
}

model IncomingType {
  id                      String     @id @default(uuid(7)) @db.Uuid
  name                    String     @unique
  category                String
  defaultUnitId           String     @db.Uuid
  defaultUnit             Unit       @relation(fields: [defaultUnitId], references: [id])
  orderRef                String?
  responseTargetDays      Int
  para103SlipWording      Boolean
  slipFooter              SlipFooter
  /// REG-01 checks: duplicate CAC, fee evidence, Schedule 2, deadline (§4.4).
  isRegistration          Boolean    @default(false)
  /// "Related OGSERC number missing" applies (§4.4).
  requiresRelatedOgsercNo Boolean    @default(false)
  sortOrder               Int        @default(0)
  active                  Boolean    @default(true)

  inwardItems InwardItem[]
  intakes     FrontDeskIntake[]
}

model OutgoingType {
  id                 String  @id @default(uuid(7)) @db.Uuid
  name               String  @unique
  responseExpected   Boolean
  responseWindowDays Int
  /// SPEC §9 R4: false for a holding reply.
  closesInwardItem   Boolean
  sortOrder          Int     @default(0)
  active             Boolean @default(true)

  outwardItems OutwardItem[]
}

/// SPEC-v2 C7: who may sign outward letters. Admin-editable.
model Signatory {
  id          String  @id @default(uuid(7)) @db.Uuid
  name        String  @unique
  designation String
  /// Pre-selected on New Outward (the Secretary to the Commission).
  isDefault   Boolean @default(false)
  sortOrder   Int     @default(0)
  active      Boolean @default(true)

  outwardItems OutwardItem[]
}

model PublicHoliday {
  id     String        @id @default(uuid(7)) @db.Uuid
  date   DateTime      @unique @db.Date
  name   String
  status HolidayStatus
  note   String?
}

/// Exactly one row (id = 1, enforced by a CHECK constraint).
model RegistrySettings {
  id                              Int          @id @default(1)
  ackPrefix                       String
  outPrefix                       String
  /// "HH:mm"
  officeClosingTime               String
  timezone                        String
  registryForwardingTargetDays    Int
  dispatchTargetDays              Int
  chaseProofOfDeliveryAfterDays   Int
  urgentResponseTargetDays        Int
  defaultResponseTargetDays       Int
  fileReturnTargetDays            Int
  effectiveDate                   DateTime     @db.Date
  effectiveDateIsPlaceholder      Boolean
  registrationDeadlineDays        Int
  /// Q1; false = Excel behaviour.
  deadlineRollsToNextWorkingDay   Boolean      @default(false)
  dashboardFirstMonth             DateTime     @db.Date
  registryAddress                 String
  schedule2RequiredDocs           Int          @default(12)
  schedule2RequiredDocsMultiState Int          @default(13)
  /// Slip footers (TEMPLATES §1). "{closingTime}" is replaced from officeClosingTime.
  slipFooterRegistration          String
  slipFooterPara103               String
  slipFooterGeneral               String
  secretaryName                   String       @default("")
  /// STACK rule 7: may the Head of Registry void items they logged themselves?
  headMayVoidOwnItems             Boolean      @default(false)
  /// Q-V2-2: email the previous unit when routing moves an item away (workbook: no).
  notifyPreviousUnitOnReroute     Boolean      @default(false)
  /// Q-V2-3: routers re-enter their password to save routing (default no).
  routingRequiresPassword         Boolean      @default(false)
  /// Q-V2-5: the front desk may log any receipt mode (workbook), not only hand delivery.
  frontDeskAnyMode                Boolean      @default(true)
  /// SPEC-v2 C3.1: front desk intake numbers.
  frontDeskPrefix                 String       @default("OGSERC/FD")
  /// SPEC-v2 C8: generated file references {filePrefix}/{code}/{NNN}.
  filePrefix                      String       @default("OGSERC")
  fileRefSerialDigits             Int          @default(3)
  /// SPEC-v2 C6.3 (the workbook's "Display" maps to REVIEW; seeded OFF).
  ackEmailMode                    AckEmailMode @default(OFF)
  ackEmailCc                      String       @default("")
  updatedAt                       DateTime     @updatedAt @db.Timestamptz
  updatedById                     String?      @db.Uuid
  updatedBy                       User?        @relation(fields: [updatedById], references: [id])
}

// ------------------------------------------------------------ registers ---

model NumberCounter {
  series    Series
  year      Int
  lastValue Int

  @@id([series, year])
}

model InwardItem {
  id         String @id @default(uuid(7)) @db.Uuid
  /// Assigned once in the insert transaction; a trigger blocks changes.
  number     String @unique
  numberYear Int
  serial     Int

  // inputs (§4.1)
  receivedAt                   DateTime      @db.Timestamptz
  modeId                       String        @db.Uuid
  mode                         ListItem      @relation("InwardMode", fields: [modeId], references: [id])
  typeId                       String        @db.Uuid
  type                         IncomingType  @relation(fields: [typeId], references: [id])
  sender                       String
  senderCategoryId             String        @db.Uuid
  senderCategory               ListItem      @relation("InwardSenderCategory", fields: [senderCategoryId], references: [id])
  subject                      String
  senderRef                    String?
  documentDate                 DateTime?     @db.Date
  relatedOgsercNo              String?
  inResponseToOutwardId        String?       @db.Uuid
  inResponseToOutward          OutwardItem?  @relation("InwardInResponseTo", fields: [inResponseToOutwardId], references: [id])
  cacNo                        String?
  principalLgaId               String?       @db.Uuid
  principalLga                 ListItem?     @relation("InwardLga", fields: [principalLgaId], references: [id])
  contactPerson                String?
  phone                        String?
  email                        String?
  deliveredBy                  String?
  volumes                      Int?
  schedule2DocsAttached        Int?
  feeEvidenceAttached          Boolean?
  paymentRef                   String?
  amountShownKobo              BigInt?
  receivedById                 String        @db.Uuid
  receivedBy                   User          @relation("InwardReceivedBy", fields: [receivedById], references: [id])
  fileId                       String?       @db.Uuid
  file                         RegistryFile? @relation(fields: [fileId], references: [id])
  unitOverrideId               String?       @db.Uuid
  unitOverride                 Unit?         @relation("InwardUnitOverride", fields: [unitOverrideId], references: [id])
  ackIssuedViaId               String        @db.Uuid
  ackIssuedVia                 ListItem      @relation("InwardAckVia", fields: [ackIssuedViaId], references: [id])
  /// Set on the Routing Desk (SPEC-v2 C4); blank until routed.
  actionRequiredId             String?       @db.Uuid
  actionRequired               ListItem?     @relation("InwardAction", fields: [actionRequiredId], references: [id])
  /// Blank = Normal.
  priorityId                   String?       @db.Uuid
  priority                     ListItem?     @relation("InwardPriority", fields: [priorityId], references: [id])
  actionOfficer                String?
  responseDueOverride          DateTime?     @db.Date
  remarks                      String?
  /// SPEC §4.4 optional tick (Q-E).
  multiState                   Boolean?
  /// Para 25 extension (§2.2).
  registrationDeadlineOverride DateTime?     @db.Date

  // routing (SPEC-v2 C5): set only on the Routing Desk
  routedById             String?          @db.Uuid
  routedBy               User?            @relation("InwardRoutedBy", fields: [routedById], references: [id])
  routedAt               DateTime?        @db.Timestamptz
  /// Forwarded after confirming it had not been routed (C5.4, E6).
  forwardedBeforeRouting Boolean          @default(false)
  /// The front desk intake this item registered (C3.2); one item per intake.
  frontDeskIntakeId      String?          @unique @db.Uuid
  frontDeskIntake        FrontDeskIntake? @relation(fields: [frontDeskIntakeId], references: [id])
  /// Addresses the acknowledgement was actually sent to, merged (C6.5, E1).
  ackEmailedTo           String[]         @default([])
  ackEmailedAt           DateTime?        @db.Timestamptz

  // handling (Update Item)
  dateForwarded         DateTime? @db.Date
  receivedByUnitOfficer String?
  dateClosedManual      DateTime? @db.Date
  closingNote           String?

  // snapshot on save (STACK rule 10)
  snapTypeName                String
  snapCategory                String
  snapOrderRef                String?
  snapDefaultUnitId           String     @db.Uuid
  snapDefaultUnit             Unit       @relation("InwardSnapDefaultUnit", fields: [snapDefaultUnitId], references: [id])
  snapResponseTargetDays      Int
  snapPara103SlipWording      Boolean
  snapSlipFooter              SlipFooter
  snapIsRegistration          Boolean
  snapRequiresRelatedOgsercNo Boolean
  snapClosingTime             String
  deemedReceiptDate           DateTime   @db.Date

  // cached for queries; recomputed on every write and nightly (§9 R6)
  routedUnitId   String        @db.Uuid
  routedUnit     Unit          @relation("InwardRoutedUnit", fields: [routedUnitId], references: [id])
  statusCache    InwardStatus?
  statusCachedOn DateTime?     @db.Date

  // void (§3.2)
  voidedAt   DateTime? @db.Timestamptz
  voidedById String?   @db.Uuid
  voidedBy   User?     @relation("InwardVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  imported    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  createdById String   @db.Uuid
  createdBy   User     @relation("InwardCreatedBy", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt @db.Timestamptz

  replies       OutwardItem[]  @relation("OutwardInReplyTo")
  routingEvents RoutingEvent[]
  emails        EmailLog[]

  @@unique([numberYear, serial])
  @@index([routedUnitId])
  @@index([deemedReceiptDate])
  @@index([receivedAt])
  @@index([cacNo])
  @@index([inResponseToOutwardId])
  @@index([fileId])
}

model OutwardItem {
  id         String @id @default(uuid(7)) @db.Uuid
  /// Assigned once in the insert transaction; a trigger blocks changes.
  number     String @unique
  numberYear Int
  serial     Int

  // inputs (§5.1)
  documentDate             DateTime      @db.Date
  typeId                   String        @db.Uuid
  type                     OutgoingType  @relation(fields: [typeId], references: [id])
  subject                  String
  addressee                String
  recipientCategoryId      String        @db.Uuid
  recipientCategory        ListItem      @relation("OutwardRecipientCategory", fields: [recipientCategoryId], references: [id])
  recipientContact         String?
  inReplyToInwardId        String?       @db.Uuid
  inReplyToInward          InwardItem?   @relation("OutwardInReplyTo", fields: [inReplyToInwardId], references: [id])
  relatedOgsercNo          String?
  fileId                   String?       @db.Uuid
  file                     RegistryFile? @relation(fields: [fileId], references: [id])
  originatingUnitId        String        @db.Uuid
  originatingUnit          Unit          @relation(fields: [originatingUnitId], references: [id])
  preparedBy               String?
  /// SPEC-v2 C7: chosen from the signatory list...
  signatoryId              String?       @db.Uuid
  signatory                Signatory?    @relation(fields: [signatoryId], references: [id], onDelete: Restrict)
  /// ...or typed, for someone not on the list (and imported rows).
  signedByText             String?
  signatoryDesignation     String
  dispatchModeId           String        @db.Uuid
  dispatchMode             ListItem      @relation("OutwardDispatchMode", fields: [dispatchModeId], references: [id])
  dateDispatched           DateTime?     @db.Date
  dispatchedById           String?       @db.Uuid
  dispatchedBy             User?         @relation("OutwardDispatchedBy", fields: [dispatchedById], references: [id])
  trackingRef              String?
  /// Null = type default.
  responseExpectedOverride Boolean?
  responseDueOverride      DateTime?     @db.Date
  remarks                  String?

  // delivery (Update Item)
  deliveryConfirmed   Boolean?
  dateDelivered       DateTime? @db.Date
  receivedByRecipient String?

  // snapshot on save (STACK rule 10)
  snapTypeName           String
  snapResponseExpected   Boolean
  snapResponseWindowDays Int
  snapClosesInwardItem   Boolean

  statusCache    OutwardStatus?
  statusCachedOn DateTime?      @db.Date

  voidedAt   DateTime? @db.Timestamptz
  voidedById String?   @db.Uuid
  voidedBy   User?     @relation("OutwardVoidedBy", fields: [voidedById], references: [id])
  voidReason String?

  imported    Boolean  @default(false)
  createdAt   DateTime @default(now()) @db.Timestamptz
  createdById String   @db.Uuid
  createdBy   User     @relation("OutwardCreatedBy", fields: [createdById], references: [id])
  updatedAt   DateTime @updatedAt @db.Timestamptz

  responses InwardItem[] @relation("InwardInResponseTo")

  @@unique([numberYear, serial])
  @@index([originatingUnitId])
  @@index([documentDate])
  @@index([dateDispatched])
  @@index([inReplyToInwardId])
  @@index([fileId])
}

// ---------------------------------------------------------------- files ---

model RegistryFile {
  id                   String    @id @default(uuid(7)) @db.Uuid
  reference            String    @unique
  title                String
  fileClassId          String?   @db.Uuid
  fileClass            ListItem? @relation("FileClass", fields: [fileClassId], references: [id])
  owningUnitId         String?   @db.Uuid
  owningUnit           Unit?     @relation(fields: [owningUnitId], references: [id])
  dateOpened           DateTime  @db.Date
  currentVolume        Int       @default(1)
  securityId           String    @db.Uuid
  security             ListItem  @relation("FileSecurity", fields: [securityId], references: [id])
  fileStatusId         String    @db.Uuid
  fileStatus           ListItem  @relation("FileStatus", fields: [fileStatusId], references: [id])
  dateClosedOrArchived DateTime? @db.Date
  remarks              String?
  createdAt            DateTime  @default(now()) @db.Timestamptz
  createdById          String    @db.Uuid
  createdBy            User      @relation(fields: [createdById], references: [id])
  updatedAt            DateTime  @updatedAt @db.Timestamptz

  inwardItems  InwardItem[]
  outwardItems OutwardItem[]
  movements    FileMovement[]
}

model FileMovement {
  id               String       @id @default(uuid(7)) @db.Uuid
  fileId           String       @db.Uuid
  file             RegistryFile @relation(fields: [fileId], references: [id])
  outAt            DateTime     @db.Timestamptz
  volume           Int?
  releasedById     String       @db.Uuid
  releasedBy       User         @relation("MovementReleasedBy", fields: [releasedById], references: [id])
  issuedTo         String
  issuedToUserId   String?      @db.Uuid
  issuedToUser     User?        @relation("MovementIssuedTo", fields: [issuedToUserId], references: [id])
  unitId           String?      @db.Uuid
  unit             Unit?        @relation(fields: [unitId], references: [id])
  purpose          String?
  returnByOverride DateTime?    @db.Date
  dateReturned     DateTime?    @db.Date
  receivedBackById String?      @db.Uuid
  receivedBackBy   User?        @relation("MovementReceivedBackBy", fields: [receivedBackById], references: [id])
  /// Issued after confirming the file was still out (§6.2).
  issuedWhileOut   Boolean      @default(false)
  createdAt        DateTime     @default(now()) @db.Timestamptz
  updatedAt        DateTime     @updatedAt @db.Timestamptz

  @@index([fileId, outAt])
}

// ----------------------------------------------------------------- jobs ---

/// One run of a scheduled job (cron or "Run now").
model JobRun {
  id            String    @id @default(uuid(7)) @db.Uuid
  job           String
  startedAt     DateTime  @db.Timestamptz
  finishedAt    DateTime? @db.Timestamptz
  ok            Boolean?
  /// Short summary shown on the Jobs screen.
  summary       String?
  result        Json?
  /// Null when started by the cron caller.
  triggeredById String?   @db.Uuid
  triggeredBy   User?     @relation(fields: [triggeredById], references: [id])

  @@index([job, startedAt])
}

// ---------------------------------------------------------------- audit ---

/// Append-only (a trigger rejects UPDATE and DELETE).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now()) @db.Timestamptz
  /// Null for system jobs and the seed.
  userId     String?  @db.Uuid
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  note       String?

  @@index([entityType, entityId])
  @@index([at])
}

// --------------------------------------------------------- v2: front desk ---

/// A document handed in at the front desk, before the Registry registers it
/// (SPEC-v2 C3). No acknowledgement is issued. Never deleted; the number never
/// changes (trigger).
model FrontDeskIntake {
  id           String        @id @default(uuid(7)) @db.Uuid
  /// OGSERC/FD/{YYYY}/{00000}; the year is the calendar year of receivedAt.
  intakeNo     String        @unique
  intakeYear   Int
  serial       Int
  receivedAt   DateTime      @db.Timestamptz
  sender       String
  subject      String
  /// "If known".
  typeId       String?       @db.Uuid
  type         IncomingType? @relation(fields: [typeId], references: [id])
  modeId       String        @db.Uuid
  mode         ListItem      @relation(fields: [modeId], references: [id])
  deliveredBy  String?
  phone        String?
  volumes      Int?
  receivedById String        @db.Uuid
  receivedBy   User          @relation(fields: [receivedById], references: [id])
  remarks      String?
  /// Set when the Registry registers it (C3.2).
  registeredAt DateTime?     @db.Timestamptz
  createdAt    DateTime      @default(now()) @db.Timestamptz
  updatedAt    DateTime      @updatedAt @db.Timestamptz

  inwardItem InwardItem?

  @@unique([intakeYear, serial])
  @@index([registeredAt])
  @@index([receivedAt])
}

// ------------------------------------------------------------ v2: routing ---

/// One save on the Routing Desk (SPEC-v2 C5.2, E4). Append-only.
model RoutingEvent {
  id           String     @id @default(uuid(7)) @db.Uuid
  inwardItemId String     @db.Uuid
  inwardItem   InwardItem @relation(fields: [inwardItemId], references: [id])
  routedById   String     @db.Uuid
  routedBy     User       @relation(fields: [routedById], references: [id])
  routedAt     DateTime   @db.Timestamptz
  /// The six routing fields before and after (only those that changed).
  before       Json
  after        Json

  @@index([inwardItemId, routedAt])
}

// -------------------------------------------------------------- v2: email ---

/// Every acknowledgement email the app queued, held for review, sent or
/// failed to send (SPEC-v2 C6.5). Nothing is recorded in Off mode.
model EmailLog {
  id            String      @id @default(uuid(7)) @db.Uuid
  inwardItemId  String      @db.Uuid
  inwardItem    InwardItem  @relation(fields: [inwardItemId], references: [id])
  kind          EmailKind
  status        EmailStatus
  to            String[]
  cc            String[]    @default([])
  subject       String
  body          String
  attempts      Int         @default(0)
  nextAttemptAt DateTime?   @db.Timestamptz
  error         String?
  sentAt        DateTime?   @db.Timestamptz
  createdById   String?     @db.Uuid
  createdBy     User?       @relation("EmailCreatedBy", fields: [createdById], references: [id])
  /// Who sent or discarded it from "Emails to review".
  reviewedById  String?     @db.Uuid
  reviewedBy    User?       @relation("EmailReviewedBy", fields: [reviewedById], references: [id])
  createdAt     DateTime    @default(now()) @db.Timestamptz
  updatedAt     DateTime    @updatedAt @db.Timestamptz

  @@index([inwardItemId, createdAt])
  @@index([status, nextAttemptAt])
}
