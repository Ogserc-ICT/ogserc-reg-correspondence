# Copy to .env and adjust. Never commit .env.

# --- Database -------------------------------------------------------------
# Local: `npm run db` starts an embedded PostgreSQL on port 5443 with these credentials.
DATABASE_URL="postgresql://ogserc:ogserc@localhost:5443/ogserc_registry"
# Vercel + Neon only: the direct (unpooled) connection, used by migrations and
# seeding. DATABASE_URL is then the pooled one. Leave empty locally.
DATABASE_URL_UNPOOLED=""
# Integration tests: `npm test` starts this cluster itself if it is not running.
# Each run DROPS and recreates this database; it must be local and end in _test.
DATABASE_URL_TEST="postgresql://ogserc:ogserc@localhost:5444/ogserc_registry_test"
# Playwright: `npm run test:e2e` starts this cluster itself if needed and
# DROPS and reseeds this database each run; it must be local and end in _e2e.
DATABASE_URL_E2E="postgresql://ogserc:ogserc@localhost:5445/ogserc_registry_e2e"

# --- Auth (Better Auth) ---------------------------------------------------
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# Public URL of the app. On Vercel it may be left unset: the production
# *.vercel.app address is used.
BETTER_AUTH_URL="http://localhost:3000"

# Dev/test only: password for the dev logins made by `npm run db:seed -- --example`.
# Leave empty for the default "Dev only pass 2026!".
DEV_SEED_PASSWORD=""

# --- Scheduled jobs -------------------------------------------------------
# Shared secret the cron caller sends to the protected jobs route.
CRON_SECRET=""

# --- Dev-only test clock (STACK §16) --------------------------------------
# Lagos local time that drives every "now" and "today", e.g. 2026-12-10T09:00
# Leave empty for the real clock. The app refuses to start in production if set.
APP_NOW=""
# Dev/test only: a file holding the clock value, read on every request, so an
# end-to-end test can move time between steps. Wins over APP_NOW when present.
APP_NOW_FILE=""
